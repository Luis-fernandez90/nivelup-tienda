# Copiá este archivo a ".env" (sin ".example") y no lo subas nunca al repo.
# Solo las variables que empiezan con VITE_ llegan al navegador — es a
# propósito, así una variable sin ese prefijo (por ejemplo una clave secreta
# de verdad) nunca termina expuesta en el código que corre en el cliente.
VITE_API_URL=https://dummyjson.com
